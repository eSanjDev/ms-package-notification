{
    "name": "esanj/notification-client",
    "description": "Laravel client package for Esanj Notification Microservice",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj",
            "email": "esanjdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/promises": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Esanj\\NotificationClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esanj\\NotificationClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\NotificationClient\\NotificationClientServiceProvider"
            ],
            "aliases": {
                "Notifier": "Esanj\\NotificationClient\\Facades\\Notifier"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
