{
    "name": "esanj/notification-client",
    "description": "Laravel client package for Esanj Notification Microservice",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj",
            "email": "esanjdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5",
        "nesbot/carbon": "^2.72|^3.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Esanj\\NotificationClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esanj\\NotificationClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\NotificationClient\\NotificationClientServiceProvider"
            ],
            "aliases": {
                "Notifier": "Esanj\\NotificationClient\\Facades\\Notifier"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
